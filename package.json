{
  "name": "@sovereignfs/tally",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/tally.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "description": "Tally: split shared expenses with the people you share them with, and see who owes whom. Runs on its own or on a Sovereign instance.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "PORT=${PORT:-3004} node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/ui": "0.92.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
