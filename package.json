{
  "name": "@sovereignfs/tally",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignfs/tally.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "description": "Tally: split shared expenses with the people you share them with, and see who owes whom. Runs on its own or on a Sovereign instance.",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "PORT=${PORT:-3004} node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "db:generate": "node scripts/db-generate.mjs",
    "db:dev": "node scripts/dev-db.mjs",
    "boot-check": "node scripts/boot-check.mjs",
    "e2e": "playwright test",
    "e2e:fast": "node scripts/e2e-shard.mjs --all",
    "manifest:check": "sovereign-manifest check",
    "generate:currencies": "node scripts/generate-currencies.ts && prettier --write src/money/currencies.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "~1.7.22",
    "@better-auth/passkey": "1.7.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.18.0",
    "@sovereignfs/config": "0.1.0",
    "@sovereignfs/ui": "0.92.0",
    "better-auth": "~1.7.22",
    "drizzle-orm": "^0.45.4",
    "hash-wasm": "4.13.0",
    "next": "^16.4.3",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sovereignfs/manifest": "^0.1.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "jose": "6.2.13",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
