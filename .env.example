# Every setting Tally reads, in one place. Copy to `.env` and edit; keep it out of version control, since it holds secrets. `deploy/` has the
# same for each way of running it. A secret may be given as NAME_FILE=/path instead of NAME=value, so that it is never in the process list.
# An instance that hosts Tally gives it what it needs itself (contracts/app-manifest.md §3), and the rest comes from the operator.

# --- The address people use ----------------------------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
TALLY_URL=http://localhost:3004

# --- Background jobs -------------------------------------------------------------------------------------------------------------------
# Mail, reminders and pruning run inside the web process. When several processes share one database, set `off` on all but
# one.
# TALLY_WORKER=on

# --- Signing in: at least one way must be on -------------------------------------------------------------------------------------------
# Email and password, passkeys and two-factor.
TALLY_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
TALLY_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
# `invite`, anyone holding a valid invitation, joins with invitations and becomes the default then (DESIGN.md §6.4).
TALLY_AUTH_SIGNUP=closed
# The shortest password, 8 to 128. Default 10.
# TALLY_AUTH_PASSWORD_MIN_LENGTH=10

# Sovereign sign-in (optional; all three together, and either way of signing in, or both, can be on). TALLY_CORE_URL is the instance's core, its OIDC
# issuer: its address with no path and no trailing slash, https (http for localhost). Register the client at core with the redirect address
# <TALLY_URL>/api/auth/callback/sovereign. Needs TALLY_URL and TALLY_AUTH_SECRET as local sign-in does; TALLY_AUTH_LOCAL may then be 0.
# TALLY_CORE_URL=https://sovereign.example.com
# TALLY_CORE_CLIENT_ID=
# TALLY_CORE_CLIENT_SECRET=

# --- Database: one of three forms --------------------------------------------------------------------------------------------------------
# `sqld` (the default), `sqlite` or `postgres`. Nothing guesses it from an address.
# TALLY_DB_DIALECT=sqld
# sqld: the service, and the address that makes its namespaces.
# TALLY_SQLD_URL=http://sqld:8080
# TALLY_SQLD_ADMIN_URL=http://sqld:8081
# sqlite: a file, for one container. Never on a network filesystem.
# TALLY_SQLITE_URL=file:/data/tally.db
# postgres: the address, a root certificate for TLS, and the most connections the app may hold (2 or more).
# TALLY_POSTGRES_URL=postgres://user:password@localhost:5432/tally
# PGSSLROOTCERT=
# TALLY_POSTGRES_POOL_MAX=10
# How long to wait for a database that is still starting, in milliseconds. Default 30000.
# TALLY_DB_CONNECT_TIMEOUT_MS=30000
# Where the migrations are, if not beside the server.
# TALLY_MIGRATIONS_DIR=

# --- Mail (optional) ---------------------------------------------------------------------------------------------------------------------
# With a host, an address is verified before first sign-in, a forgotten password is reset by a link, invitations are emailed, and notices are
# emailed when core is not doing it. Without one, none of that is offered, and an invitation is a link to copy.
# TALLY_SMTP_HOST=
# TALLY_SMTP_PORT=587
# TALLY_SMTP_USER=
# TALLY_SMTP_PASSWORD=
# The sender: `Tally <tally@example.com>`. Required with a host.
# TALLY_SMTP_FROM=

# --- The instance key --------------------------------------------------------------------------------------------------------------------
# 32 random bytes that seal any credential the app keeps for another service (a core's refresh token). It is not the key of anything people
# write in a group: that is sealed in their browsers, and the server never holds a key that opens it. Make it once and keep it with your secrets, apart from the database
# backups.   openssl rand -base64 32
TALLY_ENCRYPTION_KEY=
# When changing the key, put the old one here until the server has started once with both.
# TALLY_ENCRYPTION_KEY_PREVIOUS=
