# Copy to `.env` (next to the compose files) and edit. Keep it out of version control: it holds secrets.
# Every setting Tally reads is described in the repository's own .env.example; these are the ones a deployment sets.

# --- The address people use ---------------------------------------------------------------------------------------
# https, except on localhost, with no path. Passkeys, emailed links and the Sovereign redirect address are made from it.
TALLY_URL=http://localhost:3004
# The port on this machine that a reverse proxy sends to (the container listens on 3004, the port in sovereign.manifest.json).
# TALLY_PORT=3004

# --- Signing in: at least one way must be on to use the app -------------------------------------------------------
TALLY_AUTH_LOCAL=1
# 32 characters or more:  openssl rand -base64 48
TALLY_AUTH_SECRET=
# `closed`: the first account only. `open`: anyone who can reach the page. Unset, it is `closed`, or `open` when a Sovereign core is the only way in.
TALLY_AUTH_SIGNUP=closed

# --- The instance key ----------------------------------------------------------------------------------------------
# 32 random bytes that seal any credential the app keeps for another service. Make it once and keep it with your secrets, apart from the
# database backups.   openssl rand -base64 32
TALLY_ENCRYPTION_KEY=

# --- Mail (optional) -----------------------------------------------------------------------------------------------
# With a host, an address is verified, a password is reset by a link, invitations are emailed, and notices are emailed when core is not
# doing it. Without one, an invitation is a link to copy.
# TALLY_SMTP_HOST=
# TALLY_SMTP_PORT=587
# TALLY_SMTP_USER=
# TALLY_SMTP_PASSWORD=
# TALLY_SMTP_FROM=

# --- PostgreSQL (compose.postgres.yaml only) ----------------------------------------------------------------------
# The database's own password.   openssl rand -hex 16
POSTGRES_PASSWORD=
